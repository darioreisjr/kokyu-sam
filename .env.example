# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1
APP_NAME=kokyu-api
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Comma separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3001

LOG_LEVEL=debug

# --- Supabase ---
# Local values below match `supabase start` defaults. Replace with your
# project's values for staging/production (see docs/deployment.md).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-anon-or-publishable-key

# Only required for the (rare) operations that must bypass RLS.
# Server-only. Never expose to the frontend, logs, Swagger, or tests output.
# SUPABASE_SECRET_KEY=

# --- Observability (optional) ---
# SENTRY_DSN=
